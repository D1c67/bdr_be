{"BidProjectExt":{"CodeTypeId":1,"ProposalId":0,"ProposalSentOn":null,"FolderOrSet":0,"DueDateOption":0,"TimeZoneShort":"(PT)","SubsCanUploadProposal":1},"BidProject":{"BidProjectId":876398,"SystemName":"Martin-Harris Construction- LV","GCSystemName":"Martin-Harris Construction","Title":"UNLV Dental School Mezz & Sim Clinic","Status":null,"FullBidDueDate":"10-29-2026 11:00 AM","CodesPackages":null,"PersonId":20000002,"IsPrivate":0,"SystemId":225,"InternalOfficeId":204408,"CompanyLocationId":7681173,"Manager":"Alheli Corona","CompanyName":"G3 Electrical (Strong Source)","LocationName":"Las Vegas, NV","BidDueDate":"2026-10-29T11:00:00","TimeZoneShort":"(PT)","Address":null,"Address1":"UNLV Dental School","Address2":"1001 Shadow Lane","lat":null,"lng":null,"MyProperty":0,"City":"Las Vegas","State":"NV","Zip":"89106","PlusFour":"","Fax":"(702) 384-7736","Phone":"(702) 946-5608","Owner":"","Architect":"","AllowLateProposal":false,"ProjectDescription":"<p><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Martin~Harris Construction has been selected to provide preconstruction services for the UNLV DENTAL SCHOOL SHADOW LANE CAMPUS CMAR Project Number 908-GS. Your company has been invited to provide a proposal. Please download the drawings at your earliest convenience.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">The first portion of the project consists of the simulation clinic remodel within the UNLV Dental School campus.<br /><br /> <span style=\"text-decoration: underline;\">The bid documents for the mezzanine addition are forthcoming</span>. <br /><br />The construction will be phased and the safety of students and staff is paramount at all times during this project.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">All bids must be submitted electronically to Martin~Harris Construction via email at&nbsp;<a href=\"mailto:Las-Bids@martinharris.com\">Las-Bids@martinharris.com</a>&nbsp;by 11:00 AM on October 29th, 2026.&nbsp;<strong> No late bids will be accepted.</strong></span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Please ensure that you include 2026-2027 Wage Rates by Region - DRAFT/SOFT POST until October 1, 2026 at a minimum, unless you are a union subcontractor, and the union requires you to use their higher union rates. This wage determination is good for the entirety of the project.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Please include a valid State of Nevada Contractors license number and limit (if applicable) on all proposals and bid forms.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Submitted bids must include a completed trade scope sheet(s) along with the subcontractor&rsquo;s proposal letter.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Bid Date is October 29th, 2026 at 11:00 AM PST.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">The projects will be phased and construction must be complete by end of January 2027.</span><br /><br /><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\">Should you have any questions, please contact Sully via email at steve.osullivan@martinharris.com or by phone at (725) 252-0966.</span></p>\n<p><span style=\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\"><em>&nbsp;</em></span></p>\n<p><span style=\"font-size: 10pt; font-family: arial, helvetica, sans-serif;\"><br /><br /></span></p>","StatusId":2,"ProjectStatus":"Open to Bid","DueDateOption":0,"CodeTypeId":1,"isReceived":false,"isAccepted":false,"isDeclined":false,"isUndecided":false,"isProposed":false,"isArchived":false,"isInvited":false,"isPackage":false,"mapAddress":null,"BidProjectType":"Invited","isPastDueDateTime":false,"logoFile":"ht
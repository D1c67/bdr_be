# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key — BACKEND ONLY, never ship to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon/publishable key (used for some auth admin flows)
SUPABASE_ANON_KEY=your-anon-key
# JWT secret OR rely on JWKS discovery via SUPABASE_URL (preferred)
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# Accept legacy HS256 (shared-secret) tokens. Set false — or clear the secret
# above — once fully on asymmetric JWKS, so the shared-secret path is dead.
LEGACY_HS256_ENABLED=true

# ═══════════════════════════════ LLMs ════════════════════════════════════
# All AI features route through app/services/llm.py. Exactly ONE provider
# pool is live at a time:
#   FULL_SELF_HOSTED_LLMS_ENABLED=false → 3rd-party keys + "3rd party" models
#   FULL_SELF_HOSTED_LLMS_ENABLED=true  → the self-hosted connection + the
#     "self-hosted" models below. STRICT: while true, prompts NEVER go to a
#     3rd-party provider — an outage degrades each feature gracefully (same
#     paths as a missing API key), it never silently falls back.
FULL_SELF_HOSTED_LLMS_ENABLED=false

# ── 3rd-party provider keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ── Self-hosted connection (OpenAI-compatible /v1/chat/completions:
#    vLLM, Ollama, llama.cpp, TGI, LM Studio all work) ────────────────────
# TARGET picks which pair below is live — flip between your local server and
# the EC2 load balancer in one line.
SELF_HOSTED_LLM_TARGET=local
# Local server, e.g. Ollama: http://localhost:11434/v1 (include the /v1)
SELF_HOSTED_LLM_LOCAL_BASE_URL=
SELF_HOSTED_LLM_LOCAL_API_KEY=
# EC2 load balancer, e.g. https://llm.internal.yourdomain.com/v1
SELF_HOSTED_LLM_EC2_BASE_URL=
SELF_HOSTED_LLM_EC2_API_KEY=
# Hardening: TLS verification stays on — for an internal ALB cert point
# CA_BUNDLE at your private CA's PEM file instead of disabling it. Plain
# http:// in production refuses to boot unless ALLOW_HTTP=true (only for
# traffic that never leaves a private network).
SELF_HOSTED_LLM_TIMEOUT_SECONDS=120
SELF_HOSTED_LLM_VERIFY_TLS=true
SELF_HOSTED_LLM_CA_BUNDLE=
SELF_HOSTED_LLM_ALLOW_HTTP=false

# ── Model per feature — 3rd party (live while the switch is false) ────────
CLAUDE_BOQ_MODEL=claude-opus-4-8          # BOQ → RFQ category extraction
CLAUDE_BOQ_MAX_TOKENS=16000
CLAUDE_ESTIMATE_MODEL=claude-sonnet-4-6   # wiring cost from the bid recap
CLAUDE_TRANSLATE_MODEL=claude-opus-4-8    # i18n catalog script
OPENAI_PROPOSAL_MODEL=gpt-5.4-mini        # proposal scope lines (Send Out)
OPENAI_QUOTE_MODEL=gpt-5.4-mini           # vendor quote PDF price extraction
OPENAI_EMAIL_MATCH_MODEL=gpt-5.4-mini     # email-ingest R3 subject match
OPENAI_EMAIL_MODEL=gpt-5.4-nano           # RFQ email wording variation
OPENAI_ALIAS_MODEL=gpt-5.4-nano           # submittal-bank alternate names

# ── Model per feature — self-hosted (live while the switch is true;
#    empty = that feature is OFF in self-hosted mode). Fill these in as you
#    stand up models, e.g. llama-3.3-70b-instruct / qwen3-32b. ─────────────
SELF_HOSTED_BOQ_MODEL=
SELF_HOSTED_ESTIMATE_MODEL=
SELF_HOSTED_TRANSLATE_MODEL=
SELF_HOSTED_PROPOSAL_MODEL=
SELF_HOSTED_QUOTE_PDF_MODEL=              # PDFs are text-extracted locally (pypdf)
SELF_HOSTED_EMAIL_MATCH_MODEL=
SELF_HOSTED_EMAIL_VARY_MODEL=
SELF_HOSTED_ALIASES_MODEL=
# ══════════════════════════════════════════════════════════════════════════

# ── Microsoft Graph (email send-as bids@g3electrical.com) ────────────────
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
MS_SENDER=bids@g3electrical.com

# ── PM mailbox email ingestion ────────────────────────────────────────────
# Poll a mailbox (Inbox + Sent Items) and auto-assign every email to a project
# (conversation match → subject match → LLM subject match). The app's Graph
# permission is tenant-wide, so any mailbox works without Exchange changes.
EMAIL_INGEST_ENABLED=true
EMAIL_INGEST_MAILBOX=t.moorejr@g3electrical.com
# EMAIL_INGEST_POLL_INTERVAL_SECONDS=120
# The model for identification round 3 lives in the LLMs block above
# (OPENAI_EMAIL_MATCH_MODEL / SELF_HOSTED_EMAIL_MATCH_MODEL).
# Assign at/above this confidence; below → Unknown pool with a stored suggestion
# EMAIL_MATCH_CONFIDENCE_THRESHOLD=0.85
# EMAIL_MATCH_MAX_ATTEMPTS=5
# EMAIL_BODY_MAX_CHARS=100000

# ── App ──────────────────────────────────────────────────────────────────
# development | production. In production the app refuses to boot with an empty
# service-role key or with 2FA disabled (unless MFA_BREAK_GLASS_ACKNOWLEDGED),
# and it hides /docs, /redoc and /openapi.json.
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:4500
# Short-TTL (seconds) for signed file URLs handed to estimators
SIGNED_URL_TTL_SECONDS=900

# ── Security / 2FA ─────────────────────────────────────────────────────────
# 2FA is required for everyone. MUST be true in production. Setting it false in
# production is refused unless MFA_BREAK_GLASS_ACKNOWLEDGED=true (a deliberate,
# logged break-glass window). Enable TOTP in the Supabase dashboard BEFORE
# shipping enforcement or you lock everyone out.
MFA_REQUIRED=true
# MFA_BREAK_GLASS_ACKNOWLEDGED=false

# ── Abuse / resource limits ────────────────────────────────────────────────
# Master switch for all per-account rate limiting (set false only during an
# incident). See docs/ERROR_CODES.md for the codes users may see.
RATE_LIMIT_ENABLED=true
# Per-account budgets (see docs/ERROR_CODES.md). Raise to loosen a limit.
# AI_RATE_LIMIT_PER_MIN=5
# UPLOAD_RATE_LIMIT_PER_MIN=20
# EXPORT_RATE_LIMIT_PER_MIN=5
# BULK_SEND_RATE_LIMIT_PER_MIN=3
# OUTBOUND_EMAIL_RATE_LIMIT_PER_HOUR=60
# ESTIMATOR_RATE_LIMIT_PER_MIN=60
# Upload / body / workbook size caps (bytes).
# UPLOAD_MAX_BYTES=104857600
# MAX_REQUEST_BODY_BYTES=115343360
# BOQ_MAX_BYTES=52428800

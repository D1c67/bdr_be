# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key — BACKEND ONLY, never ship to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon/publishable key (used for some auth admin flows)
SUPABASE_ANON_KEY=your-anon-key
# JWT secret OR rely on JWKS discovery via SUPABASE_URL (preferred)
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# Accept legacy HS256 (shared-secret) tokens. Set false — or clear the secret
# above — once fully on asymmetric JWKS, so the shared-secret path is dead.
LEGACY_HS256_ENABLED=true

# ═════════════════════ Sub-app feature flags (release gating) ═════════════
# BDR is one deployment serving three sub-apps. These decide which of them this
# deployment actually serves, so the whole codebase can ship while a module that
# hasn't been tested in production yet stays dark. Flip one to true, restart, and
# the module appears — no code change and NO FRONTEND REBUILD (the browser reads
# the live values from GET /features; there is no NEXT_PUBLIC_ copy to keep in
# step). Set these on the API host — Railway for production.
#
# Off means GONE, not hidden: every route of that sub-app 404s, and the frontend
# drops its nav entry, its switcher tile and every cross-app link into it.
# All three false is refused at boot — the deployment would serve nothing.
#
# Default true, so development, staging and the test suite need none of this;
# production names the modules that are NOT ready.
#
#   BIDDING_ENABLED             the bid pipeline + the external estimator portal
#   PM_ENABLED                  Project Management (won work) + the email hub
#   CERTIFIED_PAYROLL_ENABLED   prevailing-wage reporting under /payroll
#
# The shared spine is never gated — /users, /notifications, /projects, /vendors,
# /gcs, /material-categories, /todos, /submittals — because turning one module
# off must not break the other two. See app/core/features.py.
BIDDING_ENABLED=true
PM_ENABLED=true
CERTIFIED_PAYROLL_ENABLED=true

# ── Bid File Splitter (experimental standalone tool, NOT a sub-app) ────────
# /bid-splitter: upload the raw bid-set PDFs a GC sent, a vision model
# classifies every page (electrical / mechanical / architectural drawings,
# specifications, addenda, RFP, other), and the backend splits the PDFs along
# the category boundaries. Not connected to the bidding pipeline yet.
# Default FALSE everywhere (unlike the sub-app flags): the tool is still being
# tested and tuned, so an environment has to opt in. Off = every route 404s
# and the frontend hides the page, same contract as the sub-app flags.
BID_FILE_SPLITTER_ENABLED=false

# ── RFP Ingestion sandbox (experimental standalone tool, NOT a sub-app) ────
# /ingestion-sandbox (dev accounts only): inbound RFP PDFs are processed in an
# out-of-process, credential-free sandbox that renders every page to JPEG and
# extracts sanitized text under hard resource limits; the API re-validates
# every output before it is stored. Nothing here touches the bidding pipeline.
# Default FALSE everywhere: off = every /rfp-ingest route 404s, the page is
# hidden, the queue never claims a sandbox job and the retention prune never
# runs. This is the master switch for BOTH RFP Ingestion slices: with mailboxes
# listed in RFP_EMAIL_INGESTION_INBOXES_ALLOWED it also starts the email
# intake's Graph polling loop (docs/RFP_EMAIL_INGESTION.md), so confirm that
# list is empty before flipping this on just to test the sandbox.
# The older RFP_INGEST_ENABLED spelling is still accepted as an alias; set the
# canonical name below and do not set both.
# Rollout: apply migrations 0119 and 0121 first, deploy with the flag off,
# check GET /rfp-ingest/status?self_test=1 with the flag on in staging, then
# prod. Design record: docs/RFP_INGESTION_SANDBOX.md.
RFP_INGESTION_ENABLED=false
# Office files: .docx/.xlsx/.doc/.xls are accepted on every intake path and
# converted to PDF through the Gotenberg service (GOTENBERG_URL; the API never
# opens the file itself), then verified like any upload. false = such files
# are rejected/not_pdf, no deploy needed. The converter call is bounded by the
# timeout below (must stay under half of LLM_QUEUE_LEASE_SECONDS) and the
# returned PDF by RFP_INGEST_MAX_FILE_BYTES. Gotenberg's own --api-timeout
# (30 s by default) must be at least as long or big documents come back 503.
# RFP_INGEST_OFFICE_FILES_ENABLED=true
# RFP_INGEST_OFFICE_CONVERT_TIMEOUT_SECONDS=180
# Per-file byte cap (also the Graph stream cap); must not exceed UPLOAD_MAX_BYTES.
# RFP_INGEST_MAX_FILE_BYTES=471859200
# Files per run, enforced at upload (413) and at email run creation.
# RFP_INGEST_MAX_FILES_PER_RUN=200
# Pages per file (over = rejected) and per run (overflow files are rejected).
# RFP_INGEST_MAX_PAGES_PER_FILE=3000
# RFP_INGEST_MAX_PAGES_PER_RUN=20000
# Longest page side in points a page may have before it fails individually.
# RFP_INGEST_MAX_PAGE_SIDE_PT=14400
# Rendering tiers: thumb (classification) and full (reading; the small tier
# serves pages up to the threshold). thumb <= full_small <= full.
# RFP_INGEST_THUMB_LONG_SIDE=1568
# RFP_INGEST_THUMB_JPEG_QUALITY=70
# RFP_INGEST_FULL_LONG_SIDE=4000
# RFP_INGEST_FULL_SMALL_LONG_SIDE=2200
# RFP_INGEST_FULL_SMALL_THRESHOLD_PT=1300
# RFP_INGEST_FULL_JPEG_QUALITY=85
# Text caps: characters per page and bytes per file for text.json.
# RFP_INGEST_MAX_TEXT_CHARS_PER_PAGE=200000
# RFP_INGEST_MAX_TEXT_BYTES_PER_FILE=67108864
# Thumb-tier images PDF part size; must stay under the 200 MB bucket limit.
# RFP_INGEST_IMAGES_PDF_PART_BYTES=157286400
# Parent timeouts: ready -> document, no progress after the first page, and
# the per-file wall clock clamp(base + per_page_ms x pages, 600, max).
# The page stall must be below half of LLM_QUEUE_LEASE_SECONDS.
# RFP_INGEST_OPEN_TIMEOUT_SECONDS=300
# RFP_INGEST_PAGE_STALL_SECONDS=120
# RFP_INGEST_FILE_TIMEOUT_BASE_SECONDS=300
# RFP_INGEST_FILE_TIMEOUT_PER_PAGE_MS=1500
# RFP_INGEST_FILE_TIMEOUT_MAX_SECONDS=14400
# Child rlimits per spawn: address space (at least 512), CPU seconds, the
# largest single output file, and the output-directory disk quota.
# 3072 MB of address space covers the measured RSS peaks (1.18 GB for a
# 3-sheet 30x42 in set at 4000 px, 650 to 700 MB for 36 to 40 sheet sets,
# 340 MB for a 475-page spec book) plus the virtual/RSS gap.
# RFP_INGEST_SANDBOX_MEMORY_MB=3072
# RFP_INGEST_SANDBOX_CPU_SECONDS=1800
# RFP_INGEST_SANDBOX_OUTPUT_FILE_MB=64
# RFP_INGEST_SANDBOX_DISK_MB=3072
# Free scratch disk that must remain before a file starts processing.
# RFP_INGEST_SCRATCH_RESERVE_MB=2048
# Crash respawn floor and the failed-page tolerance (ratio and floor).
# RFP_INGEST_MAX_CHILD_RESTARTS=5
# RFP_INGEST_MAX_FAILED_PAGE_RATIO=0.05
# RFP_INGEST_MIN_FAILED_PAGES_ALLOWED=2
# Sandbox children per uvicorn worker (prod runs 2 workers, so 2x).
# RFP_INGEST_SANDBOX_CONCURRENCY=1
# uid the child runs as when the API runs as root; 0 = no switch (opt-out).
# RFP_INGEST_SANDBOX_UID=65534
# Per-slot uid pool for concurrent children; size >= 2 x concurrency.
# RFP_INGEST_SANDBOX_UID_POOL_BASE=60100
# RFP_INGEST_SANDBOX_UID_POOL_SIZE=4
# Scratch root; empty = the system temp dir (Railway: a volume mount).
# RFP_INGEST_SCRATCH_DIR=
# llm_jobs priority for sandbox runs (lower runs first; LLM jobs are 100).
# RFP_INGEST_QUEUE_PRIORITY=200
# Days before derived outputs and the quarantine copy of a run are pruned.
# RFP_INGEST_RETENTION_DAYS=14
# Per-account read budget for the /rfp-ingest API (the page polls every 3 s).
# RFP_INGEST_RATE_LIMIT_PER_MIN=120

# ── RFP Ingestion: field extract and project matching ────────────────────
# After classify, each email's project name, GC, due date and bid notes are
# extracted and scored against open projects; a confident match attaches the
# GC to the existing project. Every knob is an env value and the resolved set
# is stored with each decision. Defaults shown. Design record:
# docs/RFP_MATCHING.md, section 6.
# The system may merge / mark duplicates without a person (also needs a
# verified sender and a confident LLM verdict). Keep off until the Matches
# tab shows reviewers agreeing with the system.
# RFP_MATCH_AUTO_MERGE_ENABLED=false
# Name and date form the weighted average; notes is a bonus, never in the denominator.
# RFP_MATCH_WEIGHT_NAME=0.6
# RFP_MATCH_WEIGHT_BID_DATE=0.3
# RFP_MATCH_WEIGHT_BID_NOTES=0.1
# Notes Dice below this adds nothing.
# RFP_MATCH_NOTES_MIN=0.5
# Date ladder: 1.0 inside the tolerance, DATE_SCORE_FAR inside FAR_DAYS, 0 beyond.
# RFP_MATCH_BID_DATE_TOLERANCE_DAYS=3
# RFP_MATCH_BID_DATE_FAR_DAYS=14
# RFP_MATCH_DATE_SCORE_FAR=0.5
# Added to the total when the email's due time equals the project's to the minute.
# RFP_MATCH_EXACT_TIME_BONUS=0.1
# Name-score cap when a discriminator conflicts (Phase 1 vs Phase 2).
# RFP_MATCH_CONFLICT_CAP=0.4
# Projects whose bid date is older than this are never candidates.
# RFP_MATCH_CANDIDATE_WINDOW_DAYS=30
# Total-score floor for a confident candidate / for any candidate to reach review.
# RFP_MATCH_AUTO_THRESHOLD=0.85
# RFP_MATCH_REVIEW_THRESHOLD=0.55
# Name-score floors for a confident candidate, with and without an email due date.
# RFP_MATCH_NAME_MIN_AUTO=0.8
# RFP_MATCH_NAME_MIN_AUTO_NO_DATE=0.9
# Best minus runner-up must exceed this for an automatic match or GC resolution.
# RFP_MATCH_RUNNER_UP_GAP=0.1
# Confidence floor on a 'same' verdict for a confident candidate.
# RFP_MATCH_LLM_CONFIDENCE_THRESHOLD=0.8
# Candidates kept per email and sent to the model.
# RFP_MATCH_MAX_CANDIDATES=5
# Fuzzy GC-name floor when the sender is not a known contact.
# RFP_MATCH_GC_AUTO_THRESHOLD=0.85
# Wider name-only rebid lookup: window and floor.
# RFP_MATCH_REBID_LOOKBACK_DAYS=365
# RFP_MATCH_REBID_NAME_THRESHOLD=0.85
# New Bid similar-projects check: floor and window on internal_bid_at.
# RFP_MATCH_PRECREATE_THRESHOLD=0.5
# RFP_MATCH_PRECREATE_WINDOW_DAYS=60
# Per-recipient copies of one platform message within this many minutes follow the first copy; 0 disables.
# RFP_MATCH_SIBLING_WINDOW_MINUTES=10
# Sweep lease; must cover one LLM call: LLM_BACKGROUND_WAIT_SECONDS plus the larger of
# SELF_HOSTED_LLM_TIMEOUT_SECONDS and THIRD_PARTY_LLM_TIMEOUT_SECONDS x (THIRD_PARTY_LLM_MAX_RETRIES + 1).
# RFP_EMAIL_INGESTION_LEASE_SECONDS=600
# EXTRA domains sanitized out at listing time like internal and vendor mail
# (no row, no LLM call); subdomains are covered. Leave this empty: the managed
# block list is the `rfp_blocked_senders` table (0133), edited from Settings ->
# RFP Ingestion, and it already carries buildingconnected.com, ionwave.net,
# planhub.com and planhubprojects.com as locked rows. Anything listed HERE is
# unioned with that table and cannot be unblocked from the page.
# RFP_EMAIL_INGESTION_BLOCKED_DOMAINS=

# ── RFP Ingestion: project data harvest (Procore first) ─────────────────
# After the match step finds no existing project, a `harvest` step pulls the
# project facts and the bidding documents from the invitation platform and
# parks them (facts on rfp_harvests, files in an Ingestion Sandbox run).
# Design record: docs/RFP_HARVEST.md, section 8. RFP_INGESTION_ENABLED still
# gates everything; with both Procore credentials empty there is no Procore
# harvester and procore rows go straight to done (the PipelineSuite
# harvester below needs no credentials).
RFP_HARVEST_ENABLED=false
# The Procore account the harvester logs in as (no MFA). Rotate here only.
PROCORE_LOGIN_EMAIL=
PROCORE_LOGIN_PASSWORD=
# Human pace: every Procore request waits this many seconds x a random 1.0 to 2.0.
# PROCORE_MIN_REQUEST_INTERVAL_SECONDS=2.0
# Login discipline: never two attempts closer than this; N consecutive failures
# lock logins for LOCK_SECONDS and ring the IT Admin's bell.
# PROCORE_LOGIN_MIN_INTERVAL_SECONDS=600
# PROCORE_LOGIN_MAX_FAILURES=3
# PROCORE_LOGIN_LOCK_SECONDS=21600
# PROCORE_REQUEST_TIMEOUT_SECONDS=30
# PipelineSuite (PreconSuite) portals, the GC's own plan room at
# <gc>.pipelinesuite.com (docs/RFP_PIPELINESUITE.md, section 6). No
# credentials: the invitation email carries the portal host, the Project ID
# and the Security Key, and the harvester logs in with those, one stored
# session per portal. On by default; RFP_INGESTION_ENABLED and
# RFP_HARVEST_ENABLED still gate it.
# PIPELINESUITE_ENABLED=true
# Fire the email's own open pixel and "View Files" click once per harvest.
# PIPELINESUITE_TRACKING_PINGS_ENABLED=true
# Human pace: every portal request waits this many seconds x a random 1.0 to 2.0.
# PIPELINESUITE_MIN_REQUEST_INTERVAL_SECONDS=2.0
# Login discipline, per portal: never two attempts closer than this; N
# consecutive failures lock that portal for LOCK_SECONDS and ring the bell.
# PIPELINESUITE_LOGIN_MIN_INTERVAL_SECONDS=600
# PIPELINESUITE_LOGIN_MAX_FAILURES=3
# PIPELINESUITE_LOGIN_LOCK_SECONDS=21600
# PIPELINESUITE_REQUEST_TIMEOUT_SECONDS=30
# Email harvester (docs/RFP_HARVEST.md 2.5): files for organic, general and
# nonorganic invitations, from attachments and anonymous cloud-share links.
# RFP_HARVEST_EMAIL_ENABLED=true
# RFP_HARVEST_LINK_MAX_COUNT=10
# RFP_HARVEST_FOLDER_MAX_DEPTH=4
# RFP_HARVEST_IMAGE_SIGNATURE_MAX_BYTES=102400
# GOOGLE_DRIVE_API_KEY=
# CLOUD_REQUEST_TIMEOUT_SECONDS=30
# Harvest jobs per worker (third queue claim pass) and their priority.
# RFP_HARVEST_CONCURRENCY=1
# RFP_HARVEST_QUEUE_PRIORITY=150
# A `harvest` row waits this long between sweep checks on its job.
# RFP_HARVEST_POLL_SECONDS=60
# A complete harvest younger than this is reused by later emails about the same bid.
# RFP_HARVEST_REUSE_DAYS=14
# Manifest caps: rows (<= RFP_INGEST_MAX_FILES_PER_RUN) and declared bytes.
# RFP_HARVEST_MAX_FILES=200
# RFP_HARVEST_MAX_TOTAL_BYTES=2147483648

# ── RFP Ingestion: NGEM portal invitations ──────────────────────────────
# NGEM (supplier.ionwave.net) sends no usable invitation mail, so the app
# logs into the company's supplier account on a schedule, reads the "My
# Invitations" grid, matches every open invitation against the projects and
# harvests the new ones into the sandbox. Design record:
# docs/RFP_NGEM_PORTAL.md, section 8. RFP_INGESTION_ENABLED still gates
# everything; with the credentials or the entry URL empty the feature is
# inert (no scheduler, the /rfp-portal routes still answer).
RFP_NGEM_ENABLED=false
# The shared supplier account (no MFA) and the ResponseList.aspx?e=... link
# of the Available Bids page. The URL must be on https://supplier.ionwave.net/.
NGEM_LOGIN_USERNAME=
NGEM_LOGIN_PASSWORD=
NGEM_ENTRY_URL=
# Pacific wall-clock scan times (HH:MM, 1 to 12 entries); a slot the app
# missed still runs inside the catch-up window, then it is skipped.
# RFP_NGEM_SCHEDULE_TIMES=06:30,12:00
# RFP_NGEM_CATCHUP_HOURS=4
# Scheduler and invitation-sweep tick.
# RFP_NGEM_POLL_SECONDS=60
# A confident match resolves the invitation to `exists` without a click;
# false makes it wait in the NGEM tab like the email side.
# RFP_NGEM_AUTO_RESOLVE_ENABLED=true
# Grid pages per scan, the stale-run timeout, invitations per sweep tick and
# the queue priorities: the harvest job type rides at RFP_NGEM_QUEUE_PRIORITY,
# the scan job ahead of it at RFP_NGEM_SCAN_QUEUE_PRIORITY (lower runs first;
# the two share one third-pass slot per worker, so the noon scan must not
# queue behind a morning's harvest backlog).
# RFP_NGEM_MAX_LIST_PAGES=20
# RFP_NGEM_SCAN_TIMEOUT_SECONDS=1800
# RFP_NGEM_SWEEP_BATCH=50
# RFP_NGEM_QUEUE_PRIORITY=150
# RFP_NGEM_SCAN_QUEUE_PRIORITY=140
# Human pace and login discipline against the portal (same shape as Procore).
# NGEM_MIN_REQUEST_INTERVAL_SECONDS=2.0
# NGEM_LOGIN_MIN_INTERVAL_SECONDS=600
# NGEM_LOGIN_MAX_FAILURES=3
# NGEM_LOGIN_LOCK_SECONDS=21600
# NGEM_REQUEST_TIMEOUT_SECONDS=30

# ── RFP Ingestion: project creation ─────────────────────────────────────
# After the harvest, a `create` step turns what the pipeline collected into
# a bidding project parked in Go/No-Go (name, GC, actual bid date, the
# verified documents); the intake fields nobody could fill go to the
# Estimating Admin. Design record: docs/RFP_CREATE.md, section 10.
# RFP_INGESTION_ENABLED still gates everything. The "Create project" button
# on the email detail and the NGEM modal works whatever this says; automatic
# creation at the end of the pipeline is off by default (a `create` row
# drains to `done`, where the button acts).
RFP_CREATE_AUTO_ENABLED=false
# A `create` row waits this long between re-checks while another worker
# holds the harvest's create claim; a claim older than CLAIM_SECONDS is stale.
# RFP_CREATE_POLL_SECONDS=30
# RFP_CREATE_CLAIM_SECONDS=600
# Cap on the project's bid_notes (extracted notes + harvest instructions +
# description, joined by a blank line).
# RFP_CREATE_NOTES_MAX_CHARS=4000
# Queue priority of the document promotion job (rides the harvest pass,
# behind the harvests at 150).
# RFP_CREATE_FILES_QUEUE_PRIORITY=160
# The create-time duplicate guard: a project created this many minutes ago
# with the same name for the same GC is joined instead of duplicated. 0
# disables that half of the guard (the sibling half always runs).
# RFP_CREATE_DUPLICATE_WINDOW_MINUTES=60

# ═══════════════════════════════ LLMs ════════════════════════════════════
# All AI features route through app/services/llm.py. Exactly ONE provider
# pool is live at a time:
#   FULL_SELF_HOSTED_LLMS_ENABLED=false → 3rd-party keys + "3rd party" models
#   FULL_SELF_HOSTED_LLMS_ENABLED=true  → the self-hosted connection + the
#     "self-hosted" models below. STRICT: while true, prompts NEVER go to a
#     3rd-party provider — an outage degrades each feature gracefully (same
#     paths as a missing API key), it never silently falls back.
FULL_SELF_HOSTED_LLMS_ENABLED=false

# ── 3rd-party provider keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ── Self-hosted connection (OpenAI-compatible /v1/chat/completions:
#    vLLM, Ollama, llama.cpp, TGI, LM Studio all work) ────────────────────
# TARGET picks which endpoint below is live: local | ec2 | ec2b. Each target
# is a base URL + API key + the model it serves, so switching box AND model is
# this one line. The per-feature SELF_HOSTED_*_MODEL lines further down are
# optional overrides (empty = the target's model).
SELF_HOSTED_LLM_TARGET=local
# Local server, e.g. Ollama: http://localhost:11434/v1 (include the /v1)
SELF_HOSTED_LLM_LOCAL_BASE_URL=
SELF_HOSTED_LLM_LOCAL_API_KEY=
SELF_HOSTED_LLM_LOCAL_MODEL=
# EC2 box A, e.g. https://llm.yourdomain.com/v1 (serves qwen-3.5-4b)
SELF_HOSTED_LLM_EC2_BASE_URL=
SELF_HOSTED_LLM_EC2_API_KEY=
SELF_HOSTED_LLM_EC2_MODEL=
# EC2 box B, e.g. https://llm2.yourdomain.com/v1 (serves qwen-3.8-27b)
SELF_HOSTED_LLM_EC2B_BASE_URL=
SELF_HOSTED_LLM_EC2B_API_KEY=
SELF_HOSTED_LLM_EC2B_MODEL=
# Hardening: TLS verification stays on — for an internal ALB cert point
# CA_BUNDLE at your private CA's PEM file instead of disabling it. Plain
# http:// in production refuses to boot unless ALLOW_HTTP=true (only for
# traffic that never leaves a private network).
SELF_HOSTED_LLM_TIMEOUT_SECONDS=120
SELF_HOSTED_LLM_VERIFY_TLS=true
SELF_HOSTED_LLM_CA_BUNDLE=
SELF_HOSTED_LLM_ALLOW_HTTP=false

# ── Model per feature — 3rd party (live while the switch is false) ────────
CLAUDE_BOQ_MODEL=claude-opus-4-8          # BOQ → RFQ category extraction
CLAUDE_BOQ_MAX_TOKENS=16000
CLAUDE_ESTIMATE_MODEL=claude-sonnet-4-6   # wiring cost from the bid recap
CLAUDE_TRANSLATE_MODEL=claude-opus-4-8    # i18n catalog script
OPENAI_PROPOSAL_MODEL=gpt-5.4-mini        # proposal scope lines (Send Out)
OPENAI_QUOTE_MODEL=gpt-5.4-mini           # vendor quote PDF price extraction
OPENAI_EMAIL_MATCH_MODEL=gpt-5.4-mini     # email-ingest R3 subject match
OPENAI_EMAIL_MODEL=gpt-5.4-nano           # RFQ email wording variation
OPENAI_ALIAS_MODEL=gpt-5.4-nano           # submittal-bank alternate names
OPENAI_RFP_CLASSIFY_MODEL=gpt-5.4-mini    # RFP email yes/no classification
# RFP field extraction; empty = OPENAI_RFP_CLASSIFY_MODEL
OPENAI_RFP_EXTRACT_MODEL=
# RFP project matching; empty = OPENAI_RFP_CLASSIFY_MODEL
OPENAI_RFP_MATCH_MODEL=
# Bid File Splitter page classification (vision — page images, not text).
# Unlike every other feature the VENDOR is env-selectable too, because the
# tool exists to compare models. PROVIDER picks who answers, then that
# provider's model var applies:
#   anthropic   → CLAUDE_BID_SPLIT_MODEL
#   openai      → OPENAI_BID_SPLIT_MODEL
#   self_hosted → the self-hosted connection above + the vision-capable
#                 SELF_HOSTED_BID_SPLIT_MODEL (routes ONLY this feature to the
#                 box; FULL_SELF_HOSTED_LLMS_ENABLED=true still forces ALL
#                 features self-hosted regardless of this var)
# Also see the BID_SPLIT_* tuning knobs in app/core/config.py (pages per
# call, render size, per-file page cap).
BID_SPLIT_LLM_PROVIDER=anthropic
CLAUDE_BID_SPLIT_MODEL=claude-opus-5
OPENAI_BID_SPLIT_MODEL=gpt-5.4-mini

# ── Model per feature: self-hosted (live while the switch is true) ────────
# EMPTY = the live target's SELF_HOSTED_LLM_<TARGET>_MODEL, so flipping TARGET
# moves every feature to the new box's model. Fill one in only to pin that
# feature to another model the box serves, or "off" to disable the feature in
# self-hosted mode (empty everywhere = off too).
SELF_HOSTED_BOQ_MODEL=
SELF_HOSTED_ESTIMATE_MODEL=
SELF_HOSTED_TRANSLATE_MODEL=
SELF_HOSTED_PROPOSAL_MODEL=
# PDFs are text-extracted locally (pypdf)
SELF_HOSTED_QUOTE_PDF_MODEL=
SELF_HOSTED_EMAIL_MATCH_MODEL=
SELF_HOSTED_EMAIL_VARY_MODEL=
SELF_HOSTED_ALIASES_MODEL=
# must be VISION-capable (page images)
SELF_HOSTED_BID_SPLIT_MODEL=
# RFP email yes/no classification
SELF_HOSTED_RFP_CLASSIFY_MODEL=
# RFP field extraction; empty = SELF_HOSTED_RFP_CLASSIFY_MODEL
SELF_HOSTED_RFP_EXTRACT_MODEL=
# RFP project matching; empty = SELF_HOSTED_RFP_CLASSIFY_MODEL
SELF_HOSTED_RFP_MATCH_MODEL=

# ── Model health monitoring (the sidebar's "Model status" indicator) ──────
# A background poller asks whichever providers are active above for their
# model catalog — a free metadata call, no tokens — so the app knows the
# model server is reachable BEFORE a user's extraction fails on it.
# Set LLM_HEALTH_ENABLED=false to stop the polling; the indicator then probes
# on demand when someone opens it.
LLM_HEALTH_ENABLED=true
LLM_HEALTH_POLL_INTERVAL_SECONDS=120
# Short on purpose — a health check must fail fast, unlike a real generation.
LLM_HEALTH_PROBE_TIMEOUT_SECONDS=8
LLM_HEALTH_RATE_LIMIT_PER_MIN=12

# ── LLM job queue + concurrency gate ──────────────────────────────────────
# Durable queue for the long AI jobs (BOQ extraction, general material,
# proposal lines): jobs survive restarts, transient failures retry on the
# schedule below, and the dev AI Monitor page shows queue + failure stats.
# Set LLM_QUEUE_ENABLED=false to revert dispatch to in-process background
# tasks (no retries, no restart survival).
LLM_QUEUE_ENABLED=true
LLM_QUEUE_POLL_INTERVAL_SECONDS=3
# Jobs running at once per uvicorn worker process (prod runs 2 workers).
LLM_QUEUE_WORKER_CONCURRENCY=3
# A running job whose lease expires is treated as interrupted and requeued.
LLM_QUEUE_LEASE_SECONDS=900
# Seconds between attempts for TRANSIENT failures (server down, timeout,
# overloaded, unusable output). Total attempts = 1 + number of delays.
# Permanent failures (scanned PDF, missing config, out of tokens) never retry.
LLM_QUEUE_RETRY_DELAYS=10,20,45,90,180
LLM_CALL_LOG_RETENTION_DAYS=90
# Concurrency gate: max in-flight LLM calls per provider, per worker process.
# The self-hosted default assumes the vLLM box's 8-16 sweet spot split across
# 2 prod workers. A couple of slots stay reserved for interactive calls.
LLM_MAX_CONCURRENT_SELF_HOSTED=6
LLM_MAX_CONCURRENT_THIRD_PARTY=16
LLM_INTERACTIVE_RESERVED_SLOTS=2
LLM_INTERACTIVE_WAIT_SECONDS=10
LLM_BACKGROUND_WAIT_SECONDS=180
# Anthropic / OpenAI client bounds (SDK defaults are 600s and 2 retries).
THIRD_PARTY_LLM_TIMEOUT_SECONDS=120
THIRD_PARTY_LLM_MAX_RETRIES=1
LLM_MONITOR_RATE_LIMIT_PER_MIN=120
# ══════════════════════════════════════════════════════════════════════════

# ── Microsoft Graph (email send-as bids@g3electrical.com) ────────────────
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
MS_SENDER=bids@g3electrical.com
# OneDrive owner for oversize-attachment uploads (RFQ drawings past the inline
# limit, big submittal packages). MS_SENDER is a shared mailbox with NO
# OneDrive, so this must be a licensed account with a provisioned OneDrive,
# and the app registration needs admin-consented Files.ReadWrite.All.
# Blank falls back to MS_SENDER (the link path then fails with a Graph 404).
MS_DRIVE_OWNER=
# Copied on every proposal email sent out to a GC. Blank disables the CC.
PROPOSAL_CC=bids@g3electrical.com
# Copied on every RFQ email sent out to a vendor. Blank disables the CC.
RFQ_CC=bids@g3electrical.com

# ── PM mailbox email ingestion ────────────────────────────────────────────
# Poll a mailbox (Inbox + Sent Items) and auto-assign every email to a project
# (conversation match → subject match → LLM subject match). The app's Graph
# permission is tenant-wide, so any mailbox works without Exchange changes.
EMAIL_INGEST_ENABLED=true
EMAIL_INGEST_MAILBOX=t.moorejr@g3electrical.com
# EMAIL_INGEST_POLL_INTERVAL_SECONDS=120
# The model for identification round 3 lives in the LLMs block above
# (OPENAI_EMAIL_MATCH_MODEL / SELF_HOSTED_EMAIL_MATCH_MODEL).
# Assign at/above this confidence; below → Unknown pool with a stored suggestion
# EMAIL_MATCH_CONFIDENCE_THRESHOLD=0.85
# EMAIL_MATCH_MAX_ATTEMPTS=5
# EMAIL_BODY_MAX_CHARS=100000

# ── App ──────────────────────────────────────────────────────────────────
# development | production. In production the app refuses to boot with an empty
# service-role key or with 2FA disabled (unless MFA_BREAK_GLASS_ACKNOWLEDGED),
# and it hides /docs, /redoc and /openapi.json.
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:4500
# Short-TTL (seconds) for signed file URLs handed to estimators
SIGNED_URL_TTL_SECONDS=900

# ── Security / 2FA ─────────────────────────────────────────────────────────
# 2FA is required for everyone. MUST be true in production. Setting it false in
# production is refused unless MFA_BREAK_GLASS_ACKNOWLEDGED=true (a deliberate,
# logged break-glass window). Enable TOTP in the Supabase dashboard BEFORE
# shipping enforcement or you lock everyone out.
MFA_REQUIRED=true
# MFA_BREAK_GLASS_ACKNOWLEDGED=false

# ── Abuse / resource limits ────────────────────────────────────────────────
# Master switch for all per-account rate limiting (set false only during an
# incident). See docs/ERROR_CODES.md for the codes users may see.
RATE_LIMIT_ENABLED=true
# Per-account budgets (see docs/ERROR_CODES.md). Raise to loosen a limit.
# AI_RATE_LIMIT_PER_MIN=5
# UPLOAD_RATE_LIMIT_PER_MIN=20
# EXPORT_RATE_LIMIT_PER_MIN=5
# BULK_SEND_RATE_LIMIT_PER_MIN=3
# OUTBOUND_EMAIL_RATE_LIMIT_PER_HOUR=60
# ESTIMATOR_RATE_LIMIT_PER_MIN=60
# Upload / body / workbook size caps (bytes). Defaults are 450 MB / 460 MB
# since 0132; the samples below are the older, smaller values.
# UPLOAD_MAX_BYTES=471859200
# MAX_REQUEST_BODY_BYTES=482344960
# Cap for every request except a multipart call to a known upload route
# (JSON routes keep it whatever Content-Type is sent); default 16 MB, counted
# on the bytes actually received so chunked bodies are refused too.
# MAX_JSON_BODY_BYTES=16777216
# BOQ_MAX_BYTES=52428800
